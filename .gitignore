/dist
**/*.rs.bk
*.hex
*.bin

# Generated by crates/oc-vcv-ffi/build.rs (cbindgen); regenerated on every
# `cargo build -p oc-vcv-ffi`, so it is not a source file.
/crates/oc-vcv-ffi/include/

# VCV Rack plugin build artifacts
/vcv/**/build/
/vcv/**/dist/
/vcv/**/dep/
/vcv/**/plugin.dylib
/vcv/**/plugin.so
/vcv/**/plugin.dll
# Copied from crates/oc-vcv-ffi/include/ by `cargo xtask vcv build`.
/vcv/**/src/oc_vcv_ffi.h

# Downloaded separately by each contributor (see README, "VCV Rack 2 module");
# `cargo xtask vcv --rack-dir` points at wherever it landed, and CI does not
# build the plugin at all.
/Rack-SDK/

